# Copy this file to .env.local and fill in the values there.
# .env.local is never saved to GitHub. Do not put real values in this file.

# The HUB project's address (Supabase dashboard > Project Settings > Data API)
NEXT_PUBLIC_SUPABASE_URL=

# The HUB project's publishable key (Project Settings > API Keys, starts sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Family databases are not listed here. Their addresses are stored in the hub.

# Ask the Elder: Turnstone's own Claude (Anthropic) account key. Server only:
# add it in Vercel (Project > Settings > Environment Variables), never here.
ANTHROPIC_API_KEY=

# Optional: the Claude model the Elder uses (as named in the Anthropic console).
ANTHROPIC_MODEL=

# Email reminders (the scheduled job in vercel.json). Server only: add these in
# Vercel (Project > Settings > Environment Variables), never here.
# CRON_SECRET: any long random text; Vercel sends it with each scheduled run.
CRON_SECRET=
# The hub's "vs_reminders" connection (Supabase > Connect > Session pooler,
# with the user changed to vs_reminders.<project ref>; see supabase/setup/15-reminders.sql).
HUB_REMINDERS_DATABASE_URL=
# Each family's "vs_reminders" connection, by family id: {"<family id>": "postgresql://…"}
REMINDER_DATABASES=
# Supabase's public certificate (Database > Settings > SSL configuration), to check the connections.
SUPABASE_CA_CERT=
# The email sender (use a UK or EU service).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The sender, e.g. "Turnstone Village Square <reminders@your-domain>"
SMTP_FROM=
